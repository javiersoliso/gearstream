<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="http://gearstream.local/GearStream" version="1.0.0" viewmodes="maximized">
    <tizen:application id="GearStrm01.GearStream" package="GearStrm01" required_version="4.0"/>
    <content src="index.html"/>
    <feature name="http://tizen.org/feature/screen.size.all"/>
    <icon src="icon.png"/>
    <name>GearStream</name>
    <access origin="*" subdomains="true"/>
    <tizen:content-security-policy>default-src * ws: wss:; connect-src * ws: wss:; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:</tizen:content-security-policy>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/healthinfo"/>
    <tizen:privilege name="http://tizen.org/privilege/location"/>
    <tizen:privilege name="http://tizen.org/privilege/power"/>
    <tizen:profile name="wearable"/>
    <tizen:setting background-support="enable" encryption="disable" hwkey-event="enable"/>
    <tizen:background-category value="sensor"/>
    <tizen:background-category value="location"/>
    <tizen:background-category value="background-network"/>
</widget>
